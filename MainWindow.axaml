<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TimerAndAlerm.MainWindow"
        Title="Timer and Alarm"
        Width="476" Height="560"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- 所有按钮的文字水平 + 垂直居中（高按钮如 Bell/秒表键文字默认贴顶） -->
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,5,0,10">

            <!-- panel 1：时钟 + 敲钟 -->
            <Border BorderBrush="#B4B4B4" BorderThickness="1" Margin="10,5,10,0" Padding="6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Beijing:"
                               FontSize="14"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="ClockText"
                               Text="00:00:00"
                               FontSize="28"
                               FontWeight="Bold"
                               FontFamily="Cascadia Code,Menlo,Consolas,Courier New"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            x:Name="BellButton"
                            Content="Bell"
                            Width="80" Height="44"
                            FontSize="16"
                            FontWeight="Bold"
                            Click="OnBellClick" />
                </Grid>
            </Border>

            <!-- panel 2：秒表 -->
            <Border BorderBrush="#B4B4B4" BorderThickness="1" Margin="10,5,10,0" Padding="6">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                    <TextBlock Grid.Column="0"
                               Text="Stopwatch:"
                               FontSize="14"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Button Grid.Column="1"
                            x:Name="StopwatchStartButton"
                            Content="Start"
                            Width="80" Height="40"
                            Click="OnStopwatchStart" />
                    <Button Grid.Column="2"
                            x:Name="StopwatchStopButton"
                            Content="Stop"
                            Width="80" Height="40"
                            Margin="6,0,0,0"
                            Click="OnStopwatchStop" />
                    <Button Grid.Column="3"
                            x:Name="StopwatchResetButton"
                            Content="Reset"
                            Width="80" Height="40"
                            Margin="6,0,0,0"
                            Click="OnStopwatchReset" />
                    <TextBlock Grid.Column="4"
                               x:Name="StopwatchText"
                               Text="00:00:00.000"
                               FontFamily="Cascadia Code,Menlo,Consolas,Courier New"
                               FontWeight="Bold"
                               Margin="6,0,0,0"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- panel 3：定时提醒 + 倒计时 -->
            <Border BorderBrush="#B4B4B4" BorderThickness="1" Margin="10,5,10,0" Padding="6">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">

                    <!-- 第 1 行：定时提醒（小时/分钟用自绘的"数值框 + ▲▼"，不用 NumericUpDown） -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Reminder:"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />

                        <!-- 小时输入框 -->
                        <TextBox x:Name="ReminderHourBox"
                                 Text="00"
                                 Width="75" Height="44"
                                 FontSize="20" FontWeight="Bold"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 MaxLength="2" />
                        <!-- 小时 ▲▼ -->
                        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="HourUpButton"
                                    Content="▲"
                                    Width="34" Height="20"
                                    FontSize="11" Padding="0"
                                    Click="OnHourUp" />
                            <Button x:Name="HourDownButton"
                                    Content="▼"
                                    Width="34" Height="20"
                                    FontSize="11" Padding="0"
                                    Click="OnHourDown" />
                        </StackPanel>

                        <TextBlock Text=":"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="2,0" />

                        <!-- 分钟输入框 -->
                        <TextBox x:Name="ReminderMinuteBox"
                                 Text="00"
                                 Width="75" Height="44"
                                 FontSize="20" FontWeight="Bold"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 MaxLength="2" />
                        <!-- 分钟 ▲▼ -->
                        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="MinuteUpButton"
                                    Content="▲"
                                    Width="34" Height="20"
                                    FontSize="11" Padding="0"
                                    Click="OnMinuteUp" />
                            <Button x:Name="MinuteDownButton"
                                    Content="▼"
                                    Width="34" Height="20"
                                    FontSize="11" Padding="0"
                                    Click="OnMinuteDown" />
                        </StackPanel>

                        <Button x:Name="ScheduleButton"
                                Content="Start"
                                Width="80" Height="44"
                                Margin="6,0,0,0"
                                Click="OnScheduleClick" />
                    </StackPanel>

                    <!-- 第 2 行：已设定的提醒时刻显示 -->
                    <TextBlock x:Name="ScheduleStatusText"
                               Grid.Row="1"
                               Text=""
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#2E7D32"
                               HorizontalAlignment="Center"
                               IsVisible="False" />

                    <!-- 第 3 行：倒计时输入 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="CountdownStartButton"
                                Content="Countdown"
                                Width="96" Height="30"
                                Click="OnCountdownStart" />
                        <TextBlock Text="Minutes:"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="6,0" />
                        <Button x:Name="MinusButton"
                                Content="-"
                                Width="28" Height="28"
                                Click="OnMinusClick" />
                        <TextBox x:Name="MinutesBox"
                                 Text=""
                                 Watermark="min"
                                 Width="40"
                                 TextAlignment="Center"
                                 Margin="2,0" />
                        <Button x:Name="PlusButton"
                                Content="+"
                                Width="28" Height="28"
                                Click="OnPlusClick" />
                        <Button x:Name="CountdownCancelButton"
                                Content="Cancel"
                                Width="60" Height="30"
                                Margin="6,0,0,0"
                                Click="OnCountdownCancel" />
                    </StackPanel>

                    <!-- 第 4 行：进度条 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <TextBlock Text="Progress:"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <ProgressBar x:Name="CountdownProgress"
                                     Width="240" Height="20"
                                     Margin="6,0,0,0"
                                     Minimum="0" Maximum="100" Value="0" />
                    </StackPanel>

                </Grid>
            </Border>

            <!-- panel 4：音频播放器 -->
            <Border BorderBrush="#B4B4B4" BorderThickness="1" Margin="10,5,10,0" Padding="6">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">

                    <!-- 第 1 行：按钮组 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="AddAudioButton"
                                Content="Add"
                                Width="80" Height="30"
                                Click="OnAddAudio" />
                        <Button x:Name="ClearAudioButton"
                                Content="Clear"
                                Width="80" Height="30"
                                Click="OnClearAudio" />
                        <Button x:Name="PlayAudioButton"
                                Content="Play"
                                Width="60" Height="30"
                                Click="OnPlayAudio" />
                        <Button x:Name="StopAudioButton"
                                Content="Stop"
                                Width="60" Height="30"
                                Click="OnStopAudio" />
                    </StackPanel>

                    <!-- 第 2 行：循环播放选项 -->
                    <CheckBox Grid.Row="1"
                              x:Name="LoopCheckBox"
                              Content="Loop" />

                    <!-- 第 3 行：播放列表 TextBox -->
                    <TextBox Grid.Row="2"
                             x:Name="AudioListBox"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             TextAlignment="Center"
                             Height="170" />

                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</Window>
